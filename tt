    SELECT 'fixed_rate', 'FLOAT64' UNION ALL
    SELECT 'funds_transfer_rate', 'FLOAT64'
)

SELECT
    e.column_name,
    e.expected_type,
    c.data_type AS actual_type
FROM expected e
LEFT JOIN
    `db-dev-7d9v-mp-dap.dap_businessvault_loyalty_dev_fra.INFORMATION_SCHEMA.COLUMNS` c
    ON c.table_name =
       'rawview_loyalty_sdda_deposits_positions_interest_rates'
   AND c.column_name = e.column_name
WHERE c.column_name IS NULL
   OR c.data_type != e.expected_type;


-- =====================================================================
-- SDDA-TC-04
-- Validate SDDA source consolidation
--
-- For business dates where source data exists:
-- Deposit data must exist in target.
-- Position data must populate Position fields.
-- Interest Rate data must populate Interest fields.
-- =====================================================================

WITH source_dates AS (
    SELECT
        business_date,
        COUNT(*) AS deposit_count,
        0 AS position_count,
        0 AS interest_count
    FROM `db-dev-7d9v-mp-dap.dap_staging_sdda_de_dev_fra.sdda_deposits_eod_snapshots`
    GROUP BY business_date

    UNION ALL

    SELECT
        business_date,
        0,
        COUNT(*),
        0
    FROM `db-dev-7d9v-mp-dap.dap_staging_sdda_de_dev_fra.sdda_positions_eod_snapshots`
    GROUP BY business_date

    UNION ALL

    SELECT
        business_date,
        0,
        0,
        COUNT(*)
    FROM `db-dev-7d9v-mp-dap.dap_staging_sdda_de_dev_fra.sdda_interest_rates_eod_snapshots`
    GROUP BY business_date
),

source_summary AS (
    SELECT
        business_date,
        SUM(deposit_count) AS deposit_count,
        SUM(position_count) AS position_count,
        SUM(interest_count) AS interest_count
    FROM source_dates
    GROUP BY business_date
),

target_summary AS (
    SELECT
        business_date,
        COUNT(*) AS target_count,

        COUNTIF(
            position_quantity IS NOT NULL
            OR position_as_of IS NOT NULL
        ) AS position_target_count,

        COUNTIF(
            interest_as_of IS NOT NULL
            OR interest_business_day_convention IS NOT NULL
            OR interest_day_count IS NOT NULL
            OR interest_payment_type IS NOT NULL
            OR interest_balance_methodology IS NOT NULL
            OR interest_rate_type IS NOT NULL
            OR spread IS NOT NULL
            OR fixed_rate IS NOT NULL
            OR funds_transfer_rate IS NOT NULL
        ) AS interest_target_count

    FROM `db-dev-7d9v-mp-dap.dap_businessvault_loyalty_dev_fra.rawview_loyalty_sdda_deposits_positions_interest_rates`
    GROUP BY business_date
)

SELECT
    s.business_date,
    s.deposit_count,
    s.position_count,
    s.interest_count,
    COALESCE(t.target_count, 0) AS target_count,
    COALESCE(t.position_target_count, 0) AS position_target_count,
    COALESCE(t.interest_target_count, 0) AS interest_target_count
FROM source_summary s
LEFT JOIN target_summary t
    USING (business_date)
WHERE
       (s.deposit_count > 0 AND COALESCE(t.target_count, 0) = 0)
    OR (s.position_count > 0 AND COALESCE(t.position_target_count, 0) = 0)
    OR (s.interest_count > 0 AND COALESCE(t.interest_target_count, 0) = 0);


