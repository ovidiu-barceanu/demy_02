-- CBDAS-2685
-- SDDA Deposits / Positions / Interest Rates
--
-- Target:
-- db-dev-7d9v-mp-dap.dap_businessvault_loyalty_dev_fra.
-- rawview_loyalty_sdda_deposits_positions_interest_rates
--
-- Sources:
-- sdda_deposits_eod_snapshots
-- sdda_positions_eod_snapshots
-- sdda_interest_rates_eod_snapshots
--
-- Source tables contain business fields inside payload JSON.
--
-- 0 rows = PASS
-- =====================================================================


-- =====================================================================
-- SDDA-TC-01
-- Validate SDDA Business Vault view existence
-- =====================================================================

SELECT
    'VIEW_NOT_FOUND' AS issue
FROM (
    SELECT COUNT(*) AS view_count
    FROM `db-dev-7d9v-mp-dap.dap_businessvault_loyalty_dev_fra.INFORMATION_SCHEMA.VIEWS`
    WHERE table_name =
        'rawview_loyalty_sdda_deposits_positions_interest_rates'
)
WHERE view_count = 0;


-- =====================================================================
-- SDDA-TC-02
-- Validate required SDDA columns exist
-- =====================================================================

WITH expected_columns AS (
    SELECT column_name
    FROM UNNEST([
        'id',
        'status',
        'abi_id',
        'brds_id',
        'prds_id',
        'crds_id',
        'koncord_id',
        'creation_date_time',
        'effective_date',
        'first_deposit_date',
        'start_date',
        'end_date',
        'maturity_date',
        'end_cash_amount',
        'currency',
        'position_quantity',
        'position_as_of',
        'interest_as_of',
        'interest_business_day_convention',
        'interest_day_count',
        'interest_payment_type',
        'interest_balance_methodology',
        'interest_rate_type',
        'spread',
        'fixed_rate',
        'funds_transfer_rate'
    ]) AS column_name
)

SELECT
    e.column_name AS missing_column
FROM expected_columns e
LEFT JOIN
    `db-dev-7d9v-mp-dap.dap_businessvault_loyalty_dev_fra.INFORMATION_SCHEMA.COLUMNS` c
    ON c.table_name =
       'rawview_loyalty_sdda_deposits_positions_interest_rates'
   AND c.column_name = e.column_name
WHERE c.column_name IS NULL;


-- =====================================================================
-- SDDA-TC-03
-- Validate mapped SDDA data types
-- =====================================================================

WITH expected AS (
    SELECT 'id' AS column_name, 'STRING' AS expected_type UNION ALL
    SELECT 'status', 'STRING' UNION ALL
    SELECT 'abi_id', 'STRING' UNION ALL
    SELECT 'brds_id', 'INT64' UNION ALL
    SELECT 'prds_id', 'INT64' UNION ALL
    SELECT 'crds_id', 'INT64' UNION ALL
    SELECT 'koncord_id', 'STRING' UNION ALL
    SELECT 'creation_date_time', 'TIMESTAMP' UNION ALL
    SELECT 'effective_date', 'DATE' UNION ALL
    SELECT 'first_deposit_date', 'DATE' UNION ALL
    SELECT 'start_date', 'DATE' UNION ALL
    SELECT 'end_date', 'DATE' UNION ALL
    SELECT 'maturity_date', 'DATE' UNION ALL
    SELECT 'end_cash_amount', 'FLOAT64' UNION ALL
    SELECT 'currency', 'STRING' UNION ALL
    SELECT 'position_quantity', 'FLOAT64' UNION ALL
    SELECT 'position_as_of', 'DATE' UNION ALL
    SELECT 'interest_as_of', 'DATE' UNION ALL
    SELECT 'interest_business_day_convention', 'STRING' UNION ALL
    SELECT 'interest_day_count', 'STRING' UNION ALL
    SELECT 'interest_payment_type', 'STRING' UNION ALL
    SELECT 'interest_balance_methodology', 'STRING' UNION ALL
    SELECT 'interest_rate_type', 'STRING' UNION ALL
