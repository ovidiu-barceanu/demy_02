-- ============================================================
-- TST 02.1 - CLIENT_PARTNER_ID - Eligible partners missing from Loyalty
-- Description:
-- Validates that partners eligible for Loyalty are present as
-- CLIENT_PARTNER_ID in the Loyalty view.
--
-- Eligibility is evaluated at PARTID level using active FKNs:
--   CLOSED_FKN = FALSE
--   ASSETTYPE = 'B'
--
-- BOTH conditions must exist for the PARTID:
--   A) At least one active FKN with GBM 0-7 or 9-19
--      (GBM 8 excluded)
--   B) At least one active FKN with SEGMENT IN (1,11,21,71)
--
-- Segment mapping:
--   1  = FK
--   11 = GK Märkte
--   21 = GK Region
--   71 = FYRST
--
-- The GBM and SEGMENT conditions may be fulfilled by different FKNs.
--
-- The partner must also have an account in the ZVKK account source.
--
-- Expected result: 0 rows = Passed
-- Status =
-- ============================================================

WITH active_fkn AS (
    SELECT
        PARTID,
        FKN,
        GBM,
        SEGMENT
    FROM `db-uat-g8rw-mp-dap.dap_businessvault_uat_fra.fkn_segmentation`
    WHERE CLOSED_FKN = FALSE
      AND ASSETTYPE = 'B'
),

eligible_fkn_partners AS (
    SELECT DISTINCT
        a.PARTID
    FROM active_fkn a
    WHERE EXISTS (
        SELECT 1
        FROM active_fkn g
        WHERE g.PARTID = a.PARTID
          AND (
              g.GBM BETWEEN 0 AND 7
              OR g.GBM BETWEEN 9 AND 19
          )
    )
    AND EXISTS (
        SELECT 1
        FROM active_fkn s
        WHERE s.PARTID = a.PARTID
          AND s.SEGMENT IN (1, 11, 21, 71)
    )
),

eligible_partners AS (
    SELECT DISTINCT
        e.PARTID
    FROM eligible_fkn_partners e
    JOIN active_fkn f
        ON f.PARTID = e.PARTID
    WHERE EXISTS (
        SELECT 1
        FROM `db-uat-g8rw-mp-dap.dap_businessvault_zvkk_uat_fra.account_account_s` a
        WHERE a.SALES_PRODUCT_ID = f.FKN
    )
)

SELECT
    e.PARTID AS CLIENT_PARTNER_ID
FROM eligible_partners e
LEFT JOIN (
    SELECT DISTINCT
        SAFE_CAST(CLIENT_PARTNER_ID AS INT64) AS CLIENT_PARTNER_ID
    FROM `db-uat-g8rw-mp-dap.dap_shared_views_loyalty_uat_fra.loyalty__denormalized_view_v1`
    WHERE CLIENT_PARTNER_ID IS NOT NULL
) l
    ON l.CLIENT_PARTNER_ID = e.PARTID
WHERE l.CLIENT_PARTNER_ID IS NULL;
